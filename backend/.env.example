# Database
DATABASE_URL=sqlite:///./gaincheck.db

# Firebase
FIREBASE_WEB_API_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# CORS (where the frontend runs)
CORS_ORIGINS=http://localhost:8501

# Language model: "ollama" (local) or "openai"
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2

# Used when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Used when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# LangSmith (optional, for evals)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gaincheck
